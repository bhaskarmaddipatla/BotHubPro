# Copy this file to .env and fill in your values.
# Never commit .env to git.

# --- Security ---
SECRET_KEY=                          # min 32 chars, random string

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ---
SENDGRID_API_KEY=
FROM_EMAIL=noreply@bothubpro.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- App ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://backend:8000
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- GitHub ---
GITHUB_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=YourBotHubProBot

# --- AI / Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Market data ---
MASSIVE_API_KEY=
POLYGON_API_KEY=

# --- IBKR ---
IBKR_USERNAME=
IBKR_PASSWORD=
IBKR_TRADING_MODE=paper          # paper | live
IBKR_READ_ONLY=no
IBKR_VNC_PASSWORD=changeme
IBKR_TRUSTED_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8
