# ── IB Gateway (server-side IBKR connection) ──────────────────────────────────
# Set these to run IB Gateway as a Docker service alongside the app.
# After setting, use host=ib-gateway port=4002 (paper) / 4003 (live) in Settings.
IBKR_USERNAME=your_ibkr_username
IBKR_PASSWORD=your_ibkr_password
IBKR_TRADING_MODE=paper        # paper | live
IBKR_READ_ONLY=no
IBKR_VNC_PASSWORD=changeme     # VNC password to view IB Gateway UI remotely
IBKR_TRUSTED_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8  # Docker bridge subnets allowed to connect

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bothubpro:bothubpro@db:5432/bothubpro
REDIS_URL=redis://redis:6379/0
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
SENDGRID_API_KEY=your_sendgrid_key
FROM_EMAIL=noreply@bothubpro.com
FRONTEND_URL=http://localhost:3000
MFA_ISSUER=BotHubPro
ENVIRONMENT=development
